---
const PHONE_LINK = "tel:+917090170092";
const EMAIL = "info@roservicesupport.co.in";

const posts = [
  {
    slug: "how-often-service-ro-water-purifier",
    title: "How Often Should You Service Your RO Water Purifier?",
    excerpt: "Regular maintenance is the key to long-lasting RO performance. Here is a complete guide on how often you should service your water purifier.",
    date: "January 15, 2025",
    category: "Maintenance"
  }
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog | RO Service Support Bangalore</title>
    <meta name="description" content="Read expert tips on RO water purifier maintenance, repair, and water quality from Bangalore's trusted water purifier service center." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://roservicesupport.co.in/blog" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { width: 100%; overflow-x: hidden; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            color: #222222; line-height: 1.5; background: #f4f7fb; 
        }

        /* Header */
        header { background: #0A2B4E; padding: 10px 0; position: sticky; top: 0; z-index: 100; }
        .header-inner { 
            display: flex; justify-content: space-between; align-items: center; 
            padding: 0 16px; max-width: 720px; margin: 0 auto;
        }
        .logo { font-weight: 800; font-size: 1.1rem; color: #ffffff; text-decoration: none; letter-spacing: 0.02em; }
        .header-btn {
            background: #f97316; color: #fff; padding: 8px 16px;
            border-radius: 20px; text-decoration: none;
            font-weight: 700; font-size: 0.8rem;
        }

        /* Container */
        .container { max-width: 720px; margin: 0 auto; padding: 40px 20px 60px; }

        /* Blog Header */
        .blog-header { margin-bottom: 32px; }
        .blog-header h1 {
            font-size: 1.9rem; font-weight: 800; color: #0A2B4E;
            margin-bottom: 12px; line-height: 1.2; text-align: justify;
        }
        .blog-header p {
            font-size: 0.95rem; color: #555;
            line-height: 1.6; text-align: justify;
        }

        /* Post Cards */
        .post-card {
            background: #fff; border-radius: 12px;
            padding: 24px 22px; margin-bottom: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            border: 1px solid #e5e7eb;
            transition: all 0.2s ease;
            text-decoration: none;
            display: block;
        }
        .post-card:hover {
            border-color: #f97316;
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(249, 115, 22, 0.08);
        }
        .post-meta {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 10px; flex-wrap: wrap;
        }
        .post-category {
            background: #fff7ed; color: #f97316;
            padding: 3px 10px; border-radius: 12px;
            font-size: 0.7rem; font-weight: 800;
            letter-spacing: 0.5px; text-transform: uppercase;
        }
        .post-date {
            font-size: 0.75rem; color: #888; font-weight: 500;
        }
        .post-title {
            font-size: 1.15rem; font-weight: 800; color: #0A2B4E;
            margin-bottom: 8px; line-height: 1.35;
            text-align: justify;
        }
        .post-excerpt {
            font-size: 0.9rem; color: #555;
            line-height: 1.6; text-align: justify;
            margin-bottom: 12px;
        }
        .read-more {
            font-size: 0.85rem; color: #f97316;
            font-weight: 700; letter-spacing: 0.3px;
        }

        /* Footer */
        footer { 
            background: #0A2B4E; color: #94a3b8;
            padding: 32px 24px 24px; text-align: center; font-size: 0.85rem; 
        }
        footer a { color: #94a3b8; text-decoration: none; margin: 0 6px; }
        footer a:hover { color: #f97316; }
        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 16px; margin-top: 16px;
            color: #64748b; font-size: 0.78rem;
        }
    </style>
</head>
<body>

    <header>
        <div class="header-inner">
            <a href="/" class="logo">RO Service Support</a>
            <a href={PHONE_LINK} class="header-btn">Call Now</a>
        </div>
    </header>

    <div class="container">
        <div class="blog-header">
            <h1>Expert Tips & Insights</h1>
            <p>Read the latest articles on RO water purifier maintenance, repair, and water quality from Bangalore's trusted service center.</p>
        </div>

        {posts.map(post => (
            <a href={`/blog/${post.slug}`} class="post-card">
                <div class="post-meta">
                    <span class="post-category">{post.category}</span>
                    <span class="post-date">{post.date}</span>
                </div>
                <h2 class="post-title">{post.title}</h2>
                <p class="post-excerpt">{post.excerpt}</p>
                <span class="read-more">Read More →</span>
            </a>
        ))}
    </div>

    <footer>
        <p style="color: #fff; font-weight: 700; font-size: 1rem; margin-bottom: 8px;">RO Service Support</p>
        <p>Bangalore, Karnataka</p>
        <p style="margin-top: 8px;">📞 +91 70901 70092</p>
        <div class="footer-bottom">
            <p>&copy; 2025 RO Service Support. All rights reserved.</p>
            <p style="margin-top: 8px;">
                <a href="/">Home</a> ·
                <a href="/about">About</a> ·
                <a href="/privacy-policy">Privacy</a>
            </p>
        </div>
    </footer>

</body>
</html>