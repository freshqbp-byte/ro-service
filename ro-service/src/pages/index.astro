    <script>
        // ===== DEVICE TRACKING (FIXED - Data Sent Before Block) =====
        (function() {
            // ⭐ APNE SAARE FINGERPRINTS YAHAN DAALO (whitelist)
            var MY_FINGERPRINTS = ['fp_i70rcm', 'fp_etkxam', 'fp_tovynh', 'fp_eewy8k', 'fp_epmihv'];

            function getFingerprint() {
                try {
                    var canvas = document.createElement('canvas');
                    var ctx = canvas.getContext('2d');
                    ctx.textBaseline = 'top';
                    ctx.font = '14px Arial';
                    ctx.fillText('RO Service Support', 2, 2);
                    var canvasData = canvas.toDataURL();

                    var gl = document.createElement('canvas').getContext('webgl');
                    var webglInfo = '';
                    if (gl) {
                        var dbg = gl.getExtension('WEBGL_debug_renderer_info');
                        if (dbg) webglInfo = gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) || '';
                    }

                    var fpData = [
                        navigator.userAgent,
                        navigator.language,
                        screen.width + 'x' + screen.height,
                        screen.colorDepth,
                        new Date().getTimezoneOffset(),
                        navigator.hardwareConcurrency || 0,
                        canvasData,
                        webglInfo
                    ].join('|');

                    var hash = 0;
                    for (var i = 0; i < fpData.length; i++) {
                        hash = ((hash << 5) - hash) + fpData.charCodeAt(i);
                        hash = hash & hash;
                    }
                    return 'fp_' + Math.abs(hash).toString(36);
                } catch(e) {
                    return 'fp_' + Math.random().toString(36).substring(2, 12);
                }
            }

            var fp = getFingerprint();
            document.cookie = 'fp=' + fp + '; max-age=' + (30 * 24 * 60 * 60) + '; path=/';

            // ⭐ WHITELIST CHECK - apna device track mat karo
            if (MY_FINGERPRINTS.indexOf(fp) !== -1) return;

            var params = new URLSearchParams(window.location.search);
            var gclid = params.get('gclid') || params.get('gbraid') || params.get('wbraid');
            if (!gclid) return;

            var key = 'wm_clicks_' + fp;
            var clicks = parseInt(localStorage.getItem(key) || '0') + 1;
            localStorage.setItem(key, clicks);

            // ⭐ PEHLE DATA BHEJO (chahe block ho ya na ho)
            fetch('/api/track-device', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    fp: fp,
                    clicks: clicks,
                    gclid: gclid,
                    url: window.location.href,
                    ua: navigator.userAgent
                })
            }).catch(function() {});

            // ⭐ PHIR BLOCK CHECK KARO
            if (clicks >= 3) {
                localStorage.setItem('wm_blocked_' + fp, 'true');
                setTimeout(function() {
                    document.documentElement.innerHTML = 
                        '<body style="font-family:-apple-system,sans-serif;text-align:center;padding:100px 20px;background:#f4f7fb;">' +
                        '<h1 style="color:#0A2B4E;font-size:1.8rem;font-weight:800;">Access Restricted</h1>' +
                        '<p style="color:#555;margin-top:16px;font-size:1rem;">Your access has been blocked due to unusual activity.</p>' +
                        '</body>';
                }, 500);
            }
        })();

        // ===== PAGE FUNCTIONALITY + CONVERSION TRACKING =====
        function generateBookingId() {
            const now = new Date();
            const year = now.getFullYear().toString().slice(-2);
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const random = Math.floor(1000 + Math.random() * 9000);
            return `RO-${year}${month}${day}-${random}`;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const bookingId = generateBookingId();
            const bookingField = document.getElementById('bookingIdField');
            if (bookingField) {
                bookingField.value = bookingId;
            }
            try { sessionStorage.setItem('bookingId', bookingId); } catch(e) {}

            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(function(item) {
                const question = item.querySelector('.faq-question');
                if (question) {
                    question.addEventListener('click', function() { item.classList.toggle('active'); });
                }
            });

            function scrollToForm() {
                const formSection = document.getElementById('serviceForm');
                if (formSection) {
                    formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    setTimeout(function() { 
                        const nameField = document.getElementById('name');
                        if (nameField) nameField.focus(); 
                    }, 600);
                }
            }

            const searchBtn = document.getElementById('searchBtn');
            const userBtn = document.getElementById('userBtn');
            const cartBtn = document.getElementById('cartBtn');
            if (searchBtn) searchBtn.addEventListener('click', scrollToForm);
            if (userBtn) userBtn.addEventListener('click', scrollToForm);
            if (cartBtn) cartBtn.addEventListener('click', scrollToForm);

            const menuBtn = document.getElementById('menuBtn');
            const dropdown = document.getElementById('dropdownMenu');

            if (menuBtn && dropdown) {
                menuBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdown.classList.toggle('show');
                });

                dropdown.querySelectorAll('a').forEach(function(link) {
                    link.addEventListener('click', function() { dropdown.classList.remove('show'); });
                });

                document.addEventListener('click', function(e) {
                    if (!menuBtn.contains(e.target) && !dropdown.contains(e.target)) {
                        dropdown.classList.remove('show');
                    }
                });
            }

            // ===== CONVERSION TRACKING WITH BLOCK CHECK =====
            const isBlocked = function() {
                var fpMatch = document.cookie.match(/fp=([^;]+)/);
                var fp = fpMatch ? fpMatch[1] : null;
                if (!fp) return false;
                return localStorage.getItem('wm_blocked_' + fp) === 'true';
            };

            const form = document.getElementById('serviceFormElement');
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (isBlocked()) {
                        e.preventDefault();
                        alert('Access Restricted');
                        return false;
                    }
                    if (typeof gtag === 'function') {
                        gtag('event', 'conversion', { 'send_to': 'AW-16577170929/4Py1CIfWm5wdEPGbzuA9' });
                    }
                });
            }

            document.querySelectorAll('a[href^="tel:"]').forEach(function(link) {
                link.addEventListener('click', function(e) {
                    if (isBlocked()) {
                        e.preventDefault();
                        alert('Access Restricted');
                        return false;
                    }
                    if (typeof gtag === 'function') {
                        gtag('event', 'conversion', { 'send_to': 'AW-16577170929/4Py1CIfWm5wdEPGbzuA9' });
                    }
                });
            });
        });

        // ===== LOAD GOOGLE TAG SCRIPT (Lazy) =====
        window.addEventListener('load', function() {
            setTimeout(function() {
                var gtagScript = document.createElement('script');
                gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=AW-16577170929';
                gtagScript.async = true;
                document.head.appendChild(gtagScript);
            }, 500);
        });
    </script>

