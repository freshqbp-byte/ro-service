    <link rel="canonical" href="https://roservicesupport.co.in/terms" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #f4f7fb; color: #222; line-height: 1.6; }
        header { background: #0A2B4E; padding: 14px 0; }
        .header-inner { display: flex; justify-content: space-between; align-items: center; padding: 0 20px; max-width: 900px; margin: 0 auto; }
        .logo { font-weight: 800; font-size: 1.1rem; color: #fff; text-decoration: none; }
        .logo span { color: #f97316; }
        .back-link { color: #fff; text-decoration: none; font-size: 0.85rem; font-weight: 600; }
        .back-link:hover { color: #f97316; }
        .container { max-width: 900px; margin: 0 auto; padding: 40px 20px 60px; }
        .page-title { font-size: 1.8rem; font-weight: 800; color: #0A2B4E; margin-bottom: 8px; text-align: justify; line-height: 1.2; }
        .page-subtitle { font-size: 0.85rem; color: #888; margin-bottom: 32px; text-align: justify; }
        .content-box { background: #fff; border-radius: 12px; padding: 32px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
        .content-box h2 { font-size: 1.15rem; font-weight: 800; color: #0A2B4E; margin-top: 24px; margin-bottom: 10px; text-align: justify; line-height: 1.3; }
        .content-box h2:first-child { margin-top: 0; }
        .content-box p { font-size: 0.92rem; color: #555; line-height: 1.75; text-align: justify; margin-bottom: 12px; }
        .content-box ul { margin: 12px 0 16px 20px; font-size: 0.92rem; color: #555; line-height: 1.75; text-align: justify; }
        .content-box li { margin-bottom: 6px; }
        footer { background: #0A2B4E; color: #94a3b8; padding: 24px; text-align: center; font-size: 0.85rem; }
        footer a { color: #f97316; text-decoration: none; }
    </style>
</head>
<body>
    <header>
        <div class="header-inner">
            <a href="/" class="logo">RO <span>Service Support</span></a>
            <a href="/" class="back-link">← Back to Home</a>
