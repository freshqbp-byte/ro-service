        .content-box { background: #fff; border-radius: 12px; padding: 32px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
        .content-box h2 { font-size: 1.15rem; font-weight: 800; color: #0A2B4E; margin-top: 24px; margin-bottom: 10px; text-align: justify; line-height: 1.3; }
        .content-box h2:first-child { margin-top: 0; }
        .content-box p { font-size: 0.92rem; color: #555; line-height: 1.75; text-align: justify; margin-bottom: 12px; }
        .content-box ul { margin: 12px 0 16px 20px; font-size: 0.92rem; color: #555; line-height: 1.75; text-align: justify; }
        .content-box li { margin-bottom: 6px; }
        footer { background: #0A2B4E; color: #94a3b8; padding: 24px; text-align: center; font-size: 0.85rem; }
        footer a { color: #f97316; text-decoration: none; }
