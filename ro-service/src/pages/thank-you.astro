---
// Thank You Page - Reads Booking ID from sessionStorage
const PHONE_LINK = "tel:+919876543210";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thank You | RO Service Support</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            background: #f4f7fb;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            background: #fff;
            border-radius: 16px;
            padding: 40px 28px;
            max-width: 520px;
            width: 100%;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            border-top: 5px solid #f97316;
        }
        .icon {
            width: 72px;
            height: 72px;
            background: #ecfdf5;
            color: #10b981;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 2.2rem;
            font-weight: 800;
        }
        h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0A2B4E;
            margin-bottom: 12px;
            line-height: 1.2;
        }
        p {
            font-size: 0.95rem;
            color: #555;
            line-height: 1.6;
            margin-bottom: 12px;
            text-align: justify;
        }

        /* Booking ID Box */
        .booking-box {
            background: #0A2B4E;
            color: #fff;
            border-radius: 12px;
            padding: 20px;
            margin: 24px 0;
        }
        .booking-box .label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.8;
            margin-bottom: 6px;
        }
        .booking-box .id {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: #f97316;
            word-break: break-all;
        }
        .booking-box .note {
            font-size: 0.75rem;
            opacity: 0.7;
            margin-top: 8px;
        }

        .info {
            background: #f9fafb;
            border-left: 4px solid #f97316;
            padding: 14px 18px;
            border-radius: 6px;
            margin: 20px 0;
            text-align: left;
            font-size: 0.88rem;
            color: #374151;
            line-height: 1.5;
        }

        .btn {
            display: inline-block;
            background: #f97316;
            color: #fff;
            padding: 14px 32px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            margin-top: 8px;
            transition: background 0.2s;
        }
        .btn:hover { background: #ea580c; }

        .btn-outline {
            display: inline-block;
            background: #fff;
            color: #0A2B4E;
            padding: 12px 28px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            border: 2px solid #0A2B4E;
            margin-top: 8px;
            margin-left: 8px;
            transition: all 0.2s;
        }
        .btn-outline:hover { background: #0A2B4E; color: #fff; }

        .copy-btn {
            background: rgba(255,255,255,0.15);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.3);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.2s;
        }
        .copy-btn:hover { background: rgba(255,255,255,0.25); }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">✓</div>
        <h1>Request Submitted!</h1>
        <p>Thank you for choosing RO Service Support. Your service request has been received and our customer support team will contact you shortly.</p>
        
        <!-- Booking ID Box -->
        <div class="booking-box">
            <div class="label">Your Booking ID</div>
            <div class="id" id="bookingId">RO-000000-0000</div>
            <div class="note">Please save this ID for future reference</div>
            <button class="copy-btn" onclick="copyBookingId()">📋 Copy ID</button>
        </div>

        <div class="info">
            <strong>What's Next?</strong><br />
            A certified technician will be assigned to your request. You will receive a call from our support team within 60 minutes. This Booking ID has also been sent to your registered email.
        </div>

        <p>For urgent assistance, please call us directly.</p>
        
        <a href={PHONE_LINK} class="btn">📞 Call Now</a>
        <a href="/" class="btn-outline">← Home</a>
    </div>

    <script>
        // Read Booking ID from sessionStorage
        document.addEventListener('DOMContentLoaded', function() {
            let bookingId = null;
            
            try {
                bookingId = sessionStorage.getItem('bookingId');
            } catch(e) {
                // sessionStorage not available
            }
            
            // Fallback: generate new ID if not found
            if (!bookingId) {
                const now = new Date();
                const year = now.getFullYear().toString().slice(-2);
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const random = Math.floor(1000 + Math.random() * 9000);
                bookingId = `RO-${year}${month}${day}-${random}`;
            }
            
            document.getElementById('bookingId').textContent = bookingId;
        });

        // Copy to clipboard
        function copyBookingId() {
            const id = document.getElementById('bookingId').textContent;
            navigator.clipboard.writeText(id).then(function() {
                const btn = document.querySelector('.copy-btn');
                const originalText = btn.textContent;
                btn.textContent = '✓ Copied!';
                setTimeout(function() {
                    btn.textContent = originalText;
                }, 2000);
            }).catch(function() {
                const textArea = document.createElement('textarea');
                textArea.value = id;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                alert('Booking ID copied: ' + id);
            });
        }
    </script>
</body>
</html>